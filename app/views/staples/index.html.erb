<main class="container staples-page">
<h1>World Staples</h1>

<p>Try: 米 発酵 蒸す / 小麦 麺 茹でる / トウモロコシ 粉 薄い 焼く メキシコ / キャッサバ 発酵 アフリカ 粒 / テフ 発酵 薄焼き 酸味</p>

<%= form_with url: staples_path, method: :get, local: true, class: "search-form" do |f| %>
  <div>
    <%= f.label :q, "Query" %>
    <%= f.text_field :q, value: @query %>
  </div>
  <div>
    <%= f.label :fermented, "Fermented" %>
    <%= f.select :fermented, [["Any", ""], ["Fermented", "true"], ["Not fermented", "false"]], selected: params[:fermented] %>
  </div>
  <div>
    <%= f.label :region, "Region" %>
    <%= f.select :region, [["Any region", ""]] + @region_options.map { |region| [filter_option_label(region), region.name_en] }, { selected: params[:region] } %>
  </div>
  <div>
    <%= f.label :ingredient, "Ingredient" %>
    <%= f.select :ingredient, [["Any ingredient", ""]] + @ingredient_options.map { |ingredient| [filter_option_label(ingredient), ingredient.name_en] }, { selected: params[:ingredient] } %>
  </div>
  <div>
    <%= f.label :cooking_method, "Cooking method" %>
    <%= f.select :cooking_method, [["Any cooking method", ""]] + @cooking_method_options.map { |cooking_method| [filter_option_label(cooking_method), cooking_method.name_en] }, { selected: params[:cooking_method] } %>
  </div>
  <div><%= f.label :price_level, "Price level" %><%= f.select :price_level, [["Any", ""]] + @price_level_options.map { |v| [v, v] }, { selected: params[:price_level] } %></div>
  <div><%= f.label :satiety_level, "Satiety level" %><%= f.select :satiety_level, [["Any", ""]] + @satiety_level_options.map { |v| [v, v] }, { selected: params[:satiety_level] } %></div>
  <div><%= f.label :storage_duration, "Storage duration" %><%= f.select :storage_duration, [["Any", ""]] + @storage_duration_options.map { |v| [v, v] }, { selected: params[:storage_duration] } %></div>
  <div><%= f.label :popularity_level, "Popularity level" %><%= f.select :popularity_level, [["Any", ""]] + @popularity_level_options.map { |v| [v, v] }, { selected: params[:popularity_level] } %></div>
  <%= f.submit "Search" %>
<% end %>

<% if @filters.present? %>
  <p class="active-filters">
    <strong>Filters:</strong>
    <% @filters.each do |key, value| %>
      <span class="filter-chip"><%= key.to_s.humanize %> = <%= key == :fermented ? (value ? "Fermented" : "Not fermented") : value %></span>
    <% end %>
    <%= link_to "Clear filters", staples_path(q: @query.presence) %>
  </p>
<% end %>

<% if @searched %>
  <h2><%= @results.size %> results for "<%= @query %>"</h2>

  <% if @results.empty? %>
    <p>No staples found.</p>
    <p>Try one of the examples above.</p>
  <% else %>
    <div class="cards">
      <% @results.each do |result| %>
        <% staple = result.staple %>
        <article class="card">
          <h3><%= link_to staple.name_ja, staple_path(staple) %></h3>
          <p><strong>EN:</strong> <%= staple.name_en.presence || "-" %> / <strong>Local:</strong> <%= staple.local_name.presence || "-" %></p>
          <p><strong>Score:</strong> <%= result.score.round(2) %></p>
          <p><strong>Matched:</strong> <%= result.matched_terms.join(", ") %></p>
          <p><%= staple.description.to_s.truncate(120) %></p>
          <% if (metric = staple.staple_metric) %>
          <p><strong>Metrics:</strong>
            calories: <%= metric.calories_kcal_per_100g || "-" %>,
            price: <%= metric.price_level || "-" %>,
            satiety: <%= metric.satiety_level || "-" %>,
            storage: <%= metric.storage_duration || "-" %>,
            popularity: <%= metric.popularity_level || "-" %>
          </p>
          <% end %>
          <p>
            <strong>Region:</strong> <%= staple.regions.map { |t| tag_label(t) }.join(", ").presence || "-" %> /
            <strong>Country:</strong> <%= staple.country_areas.map { |t| tag_label(t) }.join(", ").presence || "-" %> /
            <strong>Ingredient:</strong> <%= staple.ingredients.map { |t| tag_label(t) }.join(", ").presence || "-" %> /
            <strong>Cooking:</strong> <%= staple.cooking_methods.map { |t| tag_label(t) }.join(", ").presence || "-" %>
          </p>
          <p><%= link_to "Show details", staple_path(staple) %></p>
        </article>
      <% end %>
    </div>
  <% end %>
<% else %>
  <h2>Browse staples</h2>
  <ul>
    <% @results.each do |staple| %>
      <li><%= link_to staple.name_ja, staple_path(staple) %> (<%= staple.name_en.presence || "-" %>)</li>
    <% end %>
  </ul>
<% end %>

</main>
