<main class="container staples-page">
<h1><%= @staple.name_ja %></h1>

<p><strong>English:</strong> <%= @staple.name_en.presence || "-" %></p>
<p><strong>Local name:</strong> <%= @staple.local_name.presence || "-" %></p>
<p><span class="badge"><%= fermented_label(@staple) %></span></p>
<p><%= @staple.description.presence || "-" %></p>
<p><strong>Confidence:</strong> <%= @staple.confidence.presence || "-" %> / <strong>Review status:</strong> <%= @staple.review_status.presence || "-" %></p>
<% if (source_url = safe_source_url(@staple)) %>
  <p><%= link_to "Source URL", source_url, target: "_blank", rel: "noopener" %></p>
<% end %>

<% metric = @staple.staple_metric %>
<section>
  <h2>Staple metrics</h2>
  <p><strong>Production volume note:</strong> <%= metric&.production_volume_note.presence || "-" %></p>
  <p><strong>Price level:</strong> <%= metric&.price_level.presence || "-" %></p>
  <p><strong>Cultivation ease:</strong> <%= metric&.cultivation_ease.presence || "-" %></p>
  <p><strong>Satiety level:</strong> <%= metric&.satiety_level.presence || "-" %></p>
  <p><strong>Calories:</strong> <%= metric&.calories_kcal_per_100g || "-" %> <%= metric&.calorie_basis.presence || "" %></p>
  <p><strong>Deliciousness level:</strong> <%= metric&.deliciousness_level.presence || "-" %></p>
  <p><strong>Sweetness level:</strong> <%= metric&.sweetness_level.presence || "-" %></p>
  <p><strong>Taste profile:</strong> <%= metric&.taste_profile.presence || "-" %></p>
  <p><strong>Storage duration:</strong> <%= metric&.storage_duration.presence || "-" %></p>
  <p><strong>Storage method:</strong> <%= metric&.storage_method.presence || "-" %></p>
  <p><strong>Popularity level:</strong> <%= metric&.popularity_level.presence || "-" %></p>
  <p><strong>Metrics confidence:</strong> <%= metric&.metrics_confidence || "-" %></p>
  <p><strong>Metrics note:</strong> <%= metric&.metrics_note.presence || "-" %></p>
  <p><strong>Metrics source URL:</strong>
    <% if (url = metric && safe_source_url(metric, :metrics_source_url)) %>
      <%= link_to url, url, target: "_blank", rel: "noopener" %>
    <% else %>-<% end %>
  </p>
</section>

<% sections = {
  "Ingredients" => @staple.ingredients,
  "Ingredient families" => @staple.ingredient_families,
  "Forms" => @staple.forms,
  "Shapes" => @staple.shapes,
  "Processing methods" => @staple.processing_methods,
  "Cooking methods" => @staple.cooking_methods,
  "Textures" => @staple.textures,
  "Regions" => @staple.regions,
  "Country areas" => @staple.country_areas,
  "Serving styles" => @staple.serving_styles,
  "Staple levels" => @staple.staple_levels,
  "Search keywords" => @staple.search_keywords,
  "Aliases" => @staple.staple_aliases
} %>

<% sections.each do |title, collection| %>
  <% items = collection.to_a %>
  <section>
    <h2><%= title %></h2>
    <% if items.empty? %>
      <p>-</p>
    <% else %>
      <ul class="tag-list">
        <% items.each do |item| %>
          <% label = display_tag_label(item) %>
          <% if (path = tag_search_path(item)) %>
            <li><%= link_to label, path %></li>
          <% else %>
            <li><%= label %></li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<p><%= link_to "Back to search", staples_path %></p>

</main>
