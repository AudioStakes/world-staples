<main class="container staples-page">
<h1><%= @staple.name_ja %></h1>

<p><strong>English:</strong> <%= @staple.name_en.presence || "-" %></p>
<p><strong>Local name:</strong> <%= @staple.local_name.presence || "-" %></p>
<p><span class="badge"><%= fermented_label(@staple) %></span></p>
<p><%= @staple.description.presence || "-" %></p>
<p><strong>Confidence:</strong> <%= @staple.confidence.presence || "-" %> / <strong>Review status:</strong> <%= @staple.review_status.presence || "-" %></p>
<% if (source_url = safe_source_url(@staple)) %>
  <p><%= link_to "Source URL", source_url, target: "_blank", rel: "noopener" %></p>
<% end %>

<% sections = {
  "Ingredients" => @staple.ingredients,
  "Ingredient families" => @staple.ingredient_families,
  "Forms" => @staple.forms,
  "Shapes" => @staple.shapes,
  "Processing methods" => @staple.processing_methods,
  "Cooking methods" => @staple.cooking_methods,
  "Textures" => @staple.textures,
  "Regions" => @staple.regions,
  "Country areas" => @staple.country_areas,
  "Serving styles" => @staple.serving_styles,
  "Staple levels" => @staple.staple_levels,
  "Search keywords" => @staple.search_keywords,
  "Aliases" => @staple.staple_aliases
} %>

<% sections.each do |title, collection| %>
  <% items = collection.to_a %>
  <section>
    <h2><%= title %></h2>
    <% if items.empty? %>
      <p>-</p>
    <% else %>
      <ul class="tag-list">
        <% items.each do |item| %>
          <% label = tag_label(item).presence || item.try(:name_en).presence || item.try(:name).presence || "-" %>
          <% if (path = tag_search_path(item)) %>
            <li><%= link_to label, path %></li>
          <% else %>
            <li><%= label %></li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<p><%= link_to "Back to search", staples_path %></p>

</main>
